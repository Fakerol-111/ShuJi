# ===== 枢机 API 配置 =====
# 各部门 API 配置现在通过 UI（右上角 ⚙ 设置）管理，
# 存储于工作目录的 api_config.json 文件中。
#
# 此 .env 文件作为向后兼容的后备。
# 首次通过 UI 保存后，将自动迁移到 api_config.json。
# 后续修改请使用 UI 设置面板。
#
# 非 API 配置（如 PARTICIPATION_LEVEL）仍需编辑此文件。

# ===== 全局默认（角色未单独配置时使用） =====
DEFAULT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_API_URL=https://api.deepseek.com/chat/completions
DEFAULT_MODEL=deepseek-v4-flash

# ===== 交互参与度 =====
# 1 = 全自动（默认） 2 = 学生-关键节点确认 3 = 专业-逐步审核
PARTICIPATION_LEVEL=1

# ===== 已实现角色（兼容后备） =====
# 下方配置仅在 api_config.json 不存在时生效。
# 首次使用 UI 保存后将迁移到 JSON 格式。

