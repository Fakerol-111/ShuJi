# ===== 枢机 API 配置 =====
# 复制此文件为 .env 并填入各角色的 API 配置
# 每个角色可独立配置 API Key、API URL、模型
#
# 所有角色默认使用全局默认值（DEFAULT_*）
# 单独设置某角色则覆盖默认值

# ===== 全局默认（角色未单独配置时使用） =====
DEFAULT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_API_URL=https://api.deepseek.com/chat/completions
DEFAULT_MODEL=deepseek-chat

# ===== 交互参与度 =====
# 1 = 全自动（默认） 2 = 学生-关键节点确认 3 = 专业-逐步审核
PARTICIPATION_LEVEL=1

