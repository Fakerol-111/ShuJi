{
  "name": "Markdown Parser",
  "description": "一个轻量级 Markdown 解析器",
  "steps": [
    {
      "agent": "neige",
      "response": "分析需求：构建 Markdown 解析器。已选择 workflow_simple 流程。",
      "route": "zhongshuling",
      "actions": ["create_document", "route_to"]
    },
    {
      "agent": "zhongshuling",
      "response": "设计方案：采用行解析策略，支持标题、列表、粗斜体。",
      "actions": ["create_document"]
    },
    {
      "agent": "menxiashizhong",
      "response": "审查通过，方案可行。",
      "actions": ["update_document"]
    },
    {
      "agent": "gongbushangshu",
      "response": "已完成 parser.rs 实现，包含 5 个核心函数。",
      "actions": ["create_file", "edit_file"]
    },
    {
      "agent": "xingbushangshu",
      "response": "8/8 测试通过 ✅",
      "actions": ["run_tests"]
    }
  ]
}
